+#!/tmp/mlsweep_shims/run_config.sh
+
+# Master config for ECO scaling-law experiments.
+# This configuration is tuned for a 30M parameter model. To use with other model sizes,
+# override the following parameters via CLI or create a derived config.
+#
+# Scaling equations (based on ECO paper §4.1):
+#   - Token budget: tokens = 100 × N  (N = number of parameters in millions)
+#   - Global batch size: 512 sequences
+#   - Sequence length: 512 tokens
+#   - Training steps: steps = (100 × N × 10⁶) / (512 × 512)
+#   - Warm‑up steps: warmup = 0.1 × steps (10% of total)
+#   - Peak learning rate: lr_peak = 1.2e-3 × min(1, 50 / N)  (capped at 1.2e-3 for N ≤ 50M)
+#   - LR schedule: linear warm‑up (from 0.01×lr) to lr_peak, cosine decay to 0.1×lr_peak
+#   - Dataset: C4 (en)
+#
+# Example for 30M model:
+#   steps = (100 × 30 × 10⁶) / (512 × 512) ≈ 11446
+#   warmup = 1145
+#   lr_peak = 1.2e-3 × min(1, 50/30) = 1.2e-3 × 1 = 1.2e-3
+#
+# Override via CLI (example for 100M):
+#   --model.flavor 100M --optimizer.adamw.lr 6e-4 --training.steps 38147 --lr_scheduler.warmup_steps 3815
+#
+# Based on ECO paper hyperparameters:
+#   - AdamW, beta1=0.9, beta2=0.98, eps=1e-9, weight_decay=0.1, grad clip 1.0
+#   - T5 tokenizer (vocab=32100)
+#   - Quantization: FP8 with stochastic rounding (ECO enabled separately)
+#   - Dataset: C4 (en)
+
+[job]
+dump_folder = "./outputs/master"
+description = "ECO experiment run"
+
+[profiling]
+enable_profiling = false
+
+[metrics]
+log_freq = 1
+enable_tensorboard = false
+enable_exp = true
+
+[model]
+name = "llama3"
+flavor = "30M"
+# T5 tokenizer (vocab=32100, matches ECO paper)
+hf_assets_path = "./assets/tokenizers/t5-base"
+converters = ["activation_quant"]
+
+[optimizer]
+name = "ECOAdamW"
+
+[optimizer.adamw]
+lr = 1.2e-3  # Override per model size: 1.2e-3 * min(1, 50M / N_params) (capped at 1.2e-3 for N <= 50M)
+beta1 = 0.9
+beta2 = 0.98
+eps = 1e-9
+weight_decay = 0.1
+
+[lr_scheduler]
+warmup_steps = 1145  # Override: 10% of total steps
+decay_type = "cosine"
+min_lr_factor = 0.1
+warmup_init_factor = 0.01
+
+[training]
+local_batch_size = 64
+global_batch_size = 512
+seq_len = 512
+max_norm = 1.0
+steps = 11446  # Override per model size: (100 * N_params / (global_batch_size * seq_len))
+dataset = "c4"
+dataset_path = "/home/aaron/c4"
+
+[parallelism]
+data_parallel_replicate_degree = 1
+data_parallel_shard_degree = -1
+tensor_parallel_degree = 1
+pipeline_parallel_degree = 1
+
+[checkpoint]
+enable = true
+interval = 999999999  # final step only
+
+[activation_checkpoint]
+mode = "selective"
+selective_ac_option = "op"
+
+[compile]
+enable = false
+components = ["model", "loss"]
+
+[eco]
+enabled = true
+quantize_weights = true
+quant_dtype = "fp8"
+activation_dtype = "fp8"
+heuristic_log_freq = 1
+stochastic_rounding = true
+
+[validation]
+enable = false
+dataset = "c4_validation"
+dataset_path = "/home/aaron/c4"
+seq_len = 512
+freq = 11446
+steps = -1
