+def maybe_dequantize(tensor: torch.Tensor) -> torch.Tensor:
+    """Dequantize if tensor is QuantizedTensor, otherwise return as-is."""
+    if isinstance(tensor, QuantizedTensor):
+        return tensor.dequantize()
+    return tensor
