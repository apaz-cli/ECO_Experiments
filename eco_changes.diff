@@ -0,0 +1,79 @@
+#!/tmp/mlsweep_shims/run_config.sh
+
+# Llama 3 8B BF16 baseline (bf16 quantization, no ECO injection).
+# Same code path as ECO config for fair comparison.
+# Preset for 8 GPUs with FSDP.
+
+[job]
+dump_folder = "./outputs/llama3_8b_baseline"
+description = "Llama3 8B baseline"
+
+[profiling]
+enable_profiling = false
+
+[metrics]
+log_freq = 10
+enable_tensorboard = false
+enable_exp = true
+
+[model]
+name = "llama3"
+flavor = "8B"
+# Llama tokenizer (vocab=128256)
+hf_assets_path = "./assets/hf/Llama-3.1-8B"
