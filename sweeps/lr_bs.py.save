#!/tmp/eco/run_sweep.py
# LR and batch size sweep for finding a good base config.
#
# Dimensions: LR(7) × BS(3) × treatment(7) × speed(LBS, compile, AC)
# Speed options are singular — resolved in the first few runs, then locked in.
#
# Fixed token budget per run: steps are adjusted per batch size so that
# every run sees the same number of tokens (250M tokens per run).
# Warmup is always 10% of steps, matching the paper.
#
# Treatments:
#   bf16       — BF16 simulated quant, no ECO (baseline)
#   bf16_eco   — BF16 simulated quant + ECO (control: ECO on tiny rounding error)
#   fp8        — FP8 simulated quant, no ECO (naive quantization)
#   fp8_eco    — FP8 simulated quant + ECO (the main method from the paper, RTN)
#   fp8_eco_sr — FP8 simulated quant + ECO with stochastic rounding (paper best)
#   fp8_mw_rtn — FP32 master weights + FP8 RTN baseline (traditional quantized training)
#   fp8_mw_sr  — FP32 master weights + FP8 SR baseline
#
# Default model is 100M (from master.toml). Override for other sizes:
#   python run_sweep.py --sweep lr_bs -- --model.flavor 430M

from _common import SPEED_OPTIONS

BASE_CONFIG = "configs/experiments/master.toml"

# (eco_enabled, quant_dtype, master_weights_dtype, stochastic_rounding, activation_dtype) ---
TREATMENTS = {
    "bf16":       (False, "bf16", None, False, "bf16qcq

    q:q
    qq:pqpqpq"),
    "bf16_eco":   (True,  "bf16", None, False, "bf16"),
    "fp8_eco":    (True,  "fp8",  None, True,  "fp8"),  # ECO with RTN
    "fp8_mw_sr":  (False, "fp8",  "fp32", True,  "fp8"),  # FP32 master weights + SR baseline
}

OPTIONS = {
    **SPEED_OPTIONS,
    "treatment": {
        "values": list(TREATMENTS.keys()),
        "flags": {
            name: (
                ["--eco.enabled" if eco else "--eco.no-enabled"] +
                ["--eco.quant-dtype", qdt] +
                (["--eco.master-weights-dtype", mw] if mw is not None else []) +
                ["--eco.stochastic-rounding" if sr else "--eco.no-stochastic-rounding"] +
                ["--eco.activation-dtype", act]
            )
            for name, (eco, qdt, mw, sr, act) in TREATMENTS.items()
        },
        "name": "tmt",
    },
}
